/* Global Styles */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #F8F9FA;
    font-size: 14px;
}

QMainWindow, QWidget#MainWidget, QStackedWidget {
    background-color: #0F1117;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0F1117;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #2D3344;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #444E66;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0F1117;
    height: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #2D3344;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #444E66;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Frameless Title Bar */
QWidget#TitleBar {
    background-color: #171A22;
    border-bottom: 1px solid #1F2330;
}
QWidget#TitleBar QLabel {
    color: #B4B9C7;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#CloseBtn, QPushButton#MaxBtn, QPushButton#MinBtn {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 4px;
}
QPushButton#CloseBtn:hover {
    background-color: #E63946;
    color: white;
}
QPushButton#MaxBtn:hover, QPushButton#MinBtn:hover {
    background-color: #2D3344;
}

/* Left Navigation Rail */
QWidget#NavRail {
    background-color: #171A22;
    border-right: 1px solid #1F2330;
}

QPushButton.NavButton {
    background-color: transparent;
    color: #8C96A8;
    border: none;
    border-radius: 8px;
    padding: 14px 18px;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    margin: 4px 12px;
}
QPushButton.NavButton:hover {
    background-color: #1F2330;
    color: #F8F9FA;
}
QPushButton.NavButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0052D4, stop:1 #4364F7);
    color: #FFFFFF;
    font-weight: bold;
}

/* Cards */
QWidget.Card {
    background-color: #1F2330;
    border-radius: 12px;
    border: 1px solid #2D3344;
}

/* Buttons */
QPushButton.PrimaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0052D4, stop:1 #4364F7);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton.PrimaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1A6BFF, stop:1 #5B7BFF);
}
QPushButton.PrimaryButton:pressed {
    background-color: #0042A6;
}
QPushButton.PrimaryButton:disabled {
    background-color: #2D3344;
    color: #8C96A8;
}

QPushButton.SecondaryButton {
    background-color: #2D3344;
    color: #F8F9FA;
    border: 1px solid #444E66;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
}
QPushButton.SecondaryButton:hover {
    background-color: #3A4259;
}
QPushButton.SecondaryButton:pressed {
    background-color: #1F2330;
}
QPushButton.SecondaryButton:disabled {
    background-color: #1F2330;
    color: #556075;
    border: 1px solid #2D3344;
}

QPushButton.DangerButton {
    background-color: #E63946;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
}
QPushButton.DangerButton:hover {
    background-color: #F25763;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: #171A22;
    border: 1px solid #2D3344;
    border-radius: 8px;
    padding: 10px 14px;
    color: #F8F9FA;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4364F7;
    background-color: #1A1D27;
}

/* Combo Box Dropdown */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox QAbstractItemView {
    background-color: #1F2330;
    border: 1px solid #2D3344;
    selection-background-color: #2D3344;
    border-radius: 8px;
    outline: none;
}

/* Progress Bar */
QProgressBar {
    background-color: #171A22;
    border: 1px solid #2D3344;
    border-radius: 6px;
    text-align: center;
    color: transparent; 
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0052D4, stop:1 #4364F7);
    border-radius: 5px;
}

/* Typography Classes */
QLabel.HeroTitle {
    font-size: 42px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}
QLabel.Header1 {
    font-size: 32px;
    font-weight: 700;
    color: #FFFFFF;
}
QLabel.Header2 {
    font-size: 22px;
    font-weight: 600;
    color: #FFFFFF;
}
QLabel.Header3 {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
}
QLabel.Subtitle {
    font-size: 15px;
    color: #8C96A8;
    line-height: 1.5;
}
QLabel.StatusGreen {
    color: #2ECC71;
    font-weight: bold;
}
QLabel.StatusAmber {
    color: #F1C40F;
    font-weight: bold;
}
QLabel.StatusRed {
    color: #E74C3C;
    font-weight: bold;
}

/* Status Bar */
QWidget#StatusBar {
    background-color: #171A22;
    border-top: 1px solid #1F2330;
}
QWidget#StatusBar QLabel {
    color: #8C96A8;
    font-size: 13px;
    font-weight: 500;
}

/* Separator */
QFrame.Separator {
    background-color: #2D3344;
    max-height: 1px;
    min-height: 1px;
}
